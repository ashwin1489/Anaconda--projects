   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "years = [1990, 1992, 1994, 1996, 1998, 2000, 2003, 2005, 2007, 2010]\n",
    "runs =  [500, 700, 1100, 1500, 1800, 1200, 1700, 1300, 900, 1500]\n",
    "plt.bar(years,runs)\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Runs Scored\")\n",
    "plt.title(\"Sachin Tendulkar's yearly runs\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "0987f680-8a51-4fb7-9529-2918dbef7b8d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<matplotlib.legend.Legend at 0x1868eefd090>"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "sachin = [500, 700, 1100, 1500, 1800, 1200, 1700, 1300, 900, 1500]\n",
    "sehwag = [0, 200, 900, 1400, 1600, 1800, 1500, 1100, 800, 0]\n",
    "kohli  = [0, 0, 500, 800, 1100, 1300, 1500, 1800, 1900, 2100]\n",
    "\n",
    "x = np.arange(len(years))  # index positions\n",
    "width = 0.25\n",
    "\n",
    "\n",
    "plt.bar(x - width, sachin, width=width, label=\"Sachin\")\n",
    "plt.bar(x, sehwag, width=width, label=\"Sehwag\")\n",
    "plt.bar(x + width, kohli, width=width, label=\"Kohli\")\n",
    "\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Runs\")\n",
    "plt.title(\"Run Comparison\")\n",
    "plt.xticks(x, years)  # Show actual year instead of 0,1,2,...\n",
    "plt.legend()\n",
    "# plt.tight_layout()\n",
    "# plt.show()"
   ]
  },
